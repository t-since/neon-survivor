  "cues": [
    {
      "t0": 0.5,
      "t1": 4.8,
      "who": "",
      "text": "혈마교주가 쓰러지자 혈마전이 무너져 내리고, 핏빛 하늘이 걷히기 시작했다."
    },
    {
      "t0": 5.5,
      "t1": 9.1,
      "who": "",
      "text": "혈독환에 물들었던 사람들이 하나둘, 제 얼굴을 되찾았다."
    },
    {
      "t0": 9.8,
      "t1": 12.8,
      "who": "",
      "text": "청운산. 사부님의 무덤 앞."
    },
    {
      "t0": 13.5,
      "t1": 17.8,
      "who": "서진",
      "text": "사부님. 검을… 찾아왔습니다."
    },
    {
      "t0": 18.5,
      "t1": 23.1,
      "who": "",
      "text": "바람이 불어오면 검을 뽑고, 바람이 잦아들면 길을 떠난다."
    }
  ]
